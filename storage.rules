rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    function getUserData() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }
    
    function getRole() {
      return request.auth.token.role != null ? request.auth.token.role : getUserData().role;
    }
    
    function getUserCollege() {
      return request.auth.token.collegeId != null ? request.auth.token.collegeId : getUserData().collegeId;
    }
    
    function isMainAdmin() {
      let role = getRole();
      return role == 'main_admin' || role == 'admin' || role == 'superadmin';
    }
    
    function isCollegeAdmin() {
      return isMainAdmin() || getRole() == 'college_admin';
    }
    
    function belongsToSameCollege(collegeId) {
      return isMainAdmin() || getUserCollege() == collegeId;
    }
    
    function isAuthenticated() { return request.auth != null; }
    function isOwner(userId) { return request.auth != null && request.auth.uid == userId; }

    match /public/{allPaths=**} {
      allow read: if true;
      allow write, delete: if isAuthenticated() && (isMainAdmin() || isCollegeAdmin());
    }

    match /colleges/{collegeId}/{allPaths=**} {
      allow read: if isAuthenticated() && belongsToSameCollege(collegeId);
      allow write, delete: if isAuthenticated() && (isMainAdmin() || (isCollegeAdmin() && belongsToSameCollege(collegeId)));
    }

    match /assignments/{studentId}/{allPaths=**} {
      allow write: if isOwner(studentId) && request.resource.size < 25 * 1024 * 1024;
      allow read: if isOwner(studentId) || (isAuthenticated() && isCollegeAdmin());
    }

    match /user-avatars/{userId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) && request.resource.contentType.matches('image/.*');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
