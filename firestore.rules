rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================================
    // HELPER FUNCTIONS - COMPATIBLE WITH EXISTING AUTH
    // ============================================================================
    
    function isAuthenticated() { 
      return request.auth != null; 
    }
    
    function isOwner(userId) { 
      return isAuthenticated() && request.auth.uid == userId; 
    }

    function hasUserDoc() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return hasUserDoc() 
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data 
        : {};
    }

    // Gets role from token first (fast), falls back to Firestore doc (reliable)
    function getRole() {
      // For new registrations, default to 'student' if no role in token yet
      return isAuthenticated() && request.auth.token.keys().hasAll(['role'])
        ? request.auth.token.role
        : (hasUserDoc() ? getUserData().get('role', 'student') : 'student');
    }

    // Gets college from token first (fast), falls back to Firestore doc (reliable)
    function getUserCollege() {
      return isAuthenticated() && request.auth.token.keys().hasAll(['collegeId'])
        ? request.auth.token.collegeId
        : getUserData().get('collegeId', '');
    }

    function getUserEmail() {
      return isAuthenticated() && request.auth.token.email != null
        ? request.auth.token.email
        : '';
    }

    // Role checks
    function isMainAdmin() {
      let role = getRole();
      return role == 'main_admin' || role == 'admin' || role == 'superadmin' || role == 'trainer';
    }

    function isCollegeAdmin() {
      return isMainAdmin() || getRole() == 'college_admin';
    }

    function isStudent() {
      return getRole() == 'student';
    }

    function isAnyAdmin() {
      return isMainAdmin() || isCollegeAdmin();
    }

    function getStudentCollege() {
      return isAuthenticated() && exists(/databases/$(database)/documents/students/$(request.auth.uid))
        ? get(/databases/$(database)/documents/students/$(request.auth.uid)).data.get('collegeId', '')
        : '';
    }

    // College membership check
    function belongsToSameCollege(collegeId) {
      return isMainAdmin() || 
             (getUserCollege() != '' && getUserCollege() == collegeId) ||
             (getStudentCollege() != '' && getStudentCollege() == collegeId);
    }

    // Check if resource is shared with user (for resources with sharedWith array)
    function isSharedWithUser(sharedWith) {
      return sharedWith.hasAny(['all', '*', 'GLOBAL']) || 
             (getUserCollege() != '' && sharedWith.hasAny([getUserCollege()]));
    }

    // Check if user can access via targets array (for exams with targets)
    function canAccessViaTargets(targets) {
      return isMainAdmin() ||
             targets.hasAny(['all', '*', 'GLOBAL']) ||
             (getUserCollege() != '' && targets.hasAny([getUserCollege()]));
    }

    // Prevent privilege escalation (user can't change their own role/college)
    function canChangeOwnData() {
      return !request.resource.data.keys().hasAny(['role', 'collegeId']) ||
             (request.resource.data.role == resource.data.role && 
              request.resource.data.collegeId == resource.data.collegeId);
    }

    // ============================================================================
    // USERS COLLECTION
    // ============================================================================
    
    match /users/{userId} {
      // TEMPORARY: Fully permissive for debugging registration issues
      allow read, write: if isAuthenticated();
    }

    // ============================================================================
    // STUDENTS COLLECTION
    // ============================================================================
    
    match /students/{studentId} {
      // TEMPORARY: Fully permissive for debugging registration issues
      allow read, write: if isAuthenticated();
    }

    // ============================================================================
    // COLLEGES COLLECTION
    // ============================================================================
    
    match /colleges/{collegeId} {
      // TEMPORARY: Fully permissive for debugging registration issues
      allow read: if isAuthenticated();
      
      // Create/Delete: Main admins only
      allow create, delete: if isMainAdmin();
      
      // Update: Main admins or college admin of that specific college
      allow update: if isMainAdmin() || 
                       (isCollegeAdmin() && belongsToSameCollege(collegeId));
    }

    // ============================================================================
    // DEPARTMENTS COLLECTION
    // ============================================================================
    
    match /departments/{departmentId} {
      // TEMPORARY: Fully permissive for debugging
      allow read: if isAuthenticated();
      allow create: if isMainAdmin() || 
                       (isCollegeAdmin() && belongsToSameCollege(request.resource.data.collegeId));
      allow update, delete: if isMainAdmin() || 
                               (isCollegeAdmin() && belongsToSameCollege(resource.data.collegeId));
    }

    // ============================================================================
    // COURSES COLLECTION
    // ============================================================================
    
    match /courses/{courseId} {
      // TEMPORARY: Fully permissive for debugging
      allow read: if isAuthenticated();
      allow create: if isMainAdmin() || 
                       (isCollegeAdmin() && belongsToSameCollege(request.resource.data.collegeId));
      allow update, delete: if isMainAdmin() || 
                               (isCollegeAdmin() && belongsToSameCollege(resource.data.collegeId));
    }

    // ============================================================================
    // BATCHES COLLECTION
    // ============================================================================
    
    match /batches/{batchId} {
      // TEMPORARY: Fully permissive for debugging
      allow read: if isAuthenticated();
      
      allow create: if isMainAdmin() || 
                       (isCollegeAdmin() && belongsToSameCollege(request.resource.data.collegeId));
      allow update, delete: if isMainAdmin() || 
                               (isCollegeAdmin() && belongsToSameCollege(resource.data.collegeId));
    }

    // ============================================================================
    // RESOURCES COLLECTION (with sharing support)
    // ============================================================================
    
    match /resources/{resourceId} {
      // TEMPORARY: Fully permissive for debugging
      allow read: if isAuthenticated();
      
      allow create: if isMainAdmin() || 
                       (isCollegeAdmin() && belongsToSameCollege(request.resource.data.collegeId));
      
      allow update, delete: if isMainAdmin() || 
                               (isCollegeAdmin() && belongsToSameCollege(resource.data.collegeId));
    }

    // ============================================================================
    // QUESTIONS COLLECTION
    // ============================================================================
    
    match /questions/{questionId} {
      allow read: if isAuthenticated() && (
        isMainAdmin() ||
        belongsToSameCollege(resource.data.collegeId)
      );
      
      allow create: if isMainAdmin() || 
                       (isCollegeAdmin() && belongsToSameCollege(request.resource.data.collegeId));
      
      allow update, delete: if isMainAdmin() || 
                               (isCollegeAdmin() && belongsToSameCollege(resource.data.collegeId));
    }

    // ============================================================================
    // EXAMS COLLECTION (with targets array support)
    // ============================================================================
    
    match /exams/{examId} {
      // TEMPORARY: Fully permissive for debugging
      allow read: if isAuthenticated();
      
      allow create: if isMainAdmin() || 
                       (isCollegeAdmin() && belongsToSameCollege(request.resource.data.collegeId));
      
      allow update, delete: if isMainAdmin() || 
                               (isCollegeAdmin() && belongsToSameCollege(resource.data.collegeId));
    }

    // ============================================================================
    // EXAM RESULTS COLLECTION
    // ============================================================================
    
    match /exam_results/{resultId} {
      // Create: Students can create their own results
      allow create: if isStudent() && request.resource.data.studentId == request.auth.uid;
      
      // Read: Own results, admin access, or students in the same college (needed for leaderboard)
      allow read: if isAuthenticated() && (
        (isStudent() && belongsToSameCollege(resource.data.collegeId)) ||
        isOwner(resource.data.studentId) || 
        (getUserEmail() != '' && resource.data.studentEmail == getUserEmail()) ||
        isMainAdmin() || 
        (isCollegeAdmin() && belongsToSameCollege(resource.data.collegeId))
      );
      
      // Update/Delete: Admins only
      allow update, delete: if isMainAdmin() || 
                               (isCollegeAdmin() && belongsToSameCollege(resource.data.collegeId));
    }

    // ============================================================================
    // DOUBTS / DISCUSSIONS COLLECTION
    // ============================================================================
    
    match /doubts/{doubtId} {
      // Create: Students can ask doubts
      allow create: if isStudent() && request.resource.data.studentId == request.auth.uid;
      
      // Read: Own doubts, or anyone in same college, or admins
      allow read: if isAuthenticated() && (
        isOwner(resource.data.studentId) ||
        isMainAdmin() ||
        (isCollegeAdmin() && belongsToSameCollege(resource.data.collegeId)) ||
        (isStudent() && belongsToSameCollege(resource.data.collegeId))
      );
      
      // Update: Owner (edit question) or admins (add replies)
      allow update: if isAuthenticated() && (
        isOwner(resource.data.studentId) ||
        isMainAdmin() ||
        (isCollegeAdmin() && belongsToSameCollege(resource.data.collegeId))
      );
      
      // Delete: Admins only
      allow delete: if isMainAdmin() || 
                       (isCollegeAdmin() && belongsToSameCollege(resource.data.collegeId));
    }

    // ============================================================================
    // TRAINER NOTES COLLECTION
    // ============================================================================
    
    match /trainer_notes/{noteId} {
      // Only admins can access trainer notes
      allow read, write: if isAuthenticated() && (
        isMainAdmin() || 
        (isCollegeAdmin() && belongsToSameCollege(resource.data.collegeId))
      );
    }

    // ============================================================================
    // ANNOUNCEMENTS COLLECTION
    // ============================================================================
    
    match /announcements/{announcementId} {
      // Everyone can read announcements
      allow read: if isAuthenticated();
      
      // Only admins can create/update/delete announcements
      allow create, update, delete: if isAnyAdmin();
    }

    // ============================================================================
    // ATTENDANCE COLLECTION
    // ============================================================================
    
    match /attendance/{attendanceId} {
      allow read: if isAuthenticated() && (
        isMainAdmin() ||
        (isCollegeAdmin() && belongsToSameCollege(resource.data.collegeId)) ||
        (isStudent() && isOwner(resource.data.studentId))
      );
      
      allow create, update: if isAnyAdmin();
      allow delete: if isMainAdmin();
    }

    // ============================================================================
    // SUBMISSIONS COLLECTION (for assignments/projects)
    // ============================================================================
    
    match /submissions/{submissionId} {
      // Students can create their own submissions
      allow create: if isStudent() && request.resource.data.studentId == request.auth.uid;
      
      // Read: Own submissions or admins
      allow read: if isAuthenticated() && (
        isOwner(resource.data.studentId) ||
        isMainAdmin() ||
        (isCollegeAdmin() && belongsToSameCollege(resource.data.collegeId))
      );
      
      // Update: Students can edit their submissions (before deadline), admins can grade
      allow update: if isAuthenticated() && (
        (isStudent() && isOwner(resource.data.studentId)) ||
        isMainAdmin() ||
        (isCollegeAdmin() && belongsToSameCollege(resource.data.collegeId))
      );
      
      // Delete: Admins only
      allow delete: if isMainAdmin();
    }

    // ============================================================================
    // GLOBAL SETTINGS
    // ============================================================================
    
    match /settings/{document} {
      // Everyone can read settings
      allow read: if true;
      
      // Only main admins can write settings
      allow write: if isMainAdmin();
    }

    // ============================================================================
    // METADATA / SYSTEM COLLECTIONS
    // ============================================================================
    
    match /metadata/{document} {
      allow read: if isAuthenticated();
      allow write: if isMainAdmin();
    }

    // ============================================================================
    // DEFAULT DENY ALL (Security Fallback)
    // ============================================================================
    
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
