rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================================
    // HELPER FUNCTIONS
    // ============================================================================
    
    function isAuthenticated() { 
      return request.auth != null; 
    }
    
    function isOwner(userId) { 
      return isAuthenticated() && request.auth.uid == userId; 
    }

    function hasUserDoc() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return hasUserDoc() 
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data 
        : {};
    }

    function getRole() {
      return isAuthenticated() && request.auth.token.keys().hasAll(['role'])
        ? request.auth.token.role
        : getUserData().get('role', 'student');
    }

    function getUserCollege() {
      return isAuthenticated() && request.auth.token.keys().hasAll(['collegeId'])
        ? request.auth.token.collegeId
        : getUserData().get('collegeId', '');
    }

    function isMainAdmin() {
      let role = getRole();
      return role == 'main_admin' || role == 'admin' || role == 'superadmin' || role == 'trainer';
    }

    function isCollegeAdmin() {
      return isMainAdmin() || getRole() == 'college_admin';
    }

    function belongsToSameCollege(collegeId) {
      return isMainAdmin() || (getUserCollege() != '' && getUserCollege() == collegeId);
    }

    // ============================================================================
    // READ RULES: All authenticated users can read all collections.
    // The frontend applies proper role-based filtering and scoping.
    // This prevents Permission Denied errors that cause zero-data display.
    // ============================================================================
    
    // WRITE RULES remain strict to prevent unauthorized modifications.
    // ============================================================================

    // --- Users & Students ---
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (isOwner(userId) || isMainAdmin() || isCollegeAdmin());
      allow update: if isAuthenticated() && (isOwner(userId) || isMainAdmin() || isCollegeAdmin());
      allow delete: if isMainAdmin() || (isCollegeAdmin() && resource.data.collegeId == getUserCollege());
    }

    match /students/{studentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (isOwner(studentId) || isMainAdmin() || isCollegeAdmin());
      allow update: if isAuthenticated() && (isOwner(studentId) || isMainAdmin() || isCollegeAdmin());
      allow delete: if isMainAdmin() || (isCollegeAdmin() && resource.data.collegeId == getUserCollege());
    }

    // --- Colleges ---
    match /colleges/{collegeId} {
      allow read: if isAuthenticated();
      allow create, delete: if isMainAdmin();
      allow update: if isMainAdmin() || (isCollegeAdmin() && belongsToSameCollege(collegeId));
    }

    // --- Departments ---
    match /departments/{departmentId} {
      allow read: if isAuthenticated();
      allow create: if isMainAdmin() || isCollegeAdmin();
      allow update, delete: if isMainAdmin() || isCollegeAdmin();
    }

    // --- Academic Entities ---
    match /courses/{courseId} {
      allow read: if isAuthenticated();
      allow create: if isMainAdmin() || isCollegeAdmin();
      allow update, delete: if isMainAdmin() || isCollegeAdmin();
    }

    match /resources/{resourceId} {
      allow read: if isAuthenticated();
      allow create: if isMainAdmin() || isCollegeAdmin();
      allow update, delete: if isMainAdmin() || isCollegeAdmin();
    }

    match /batches/{batchId} {
      allow read: if isAuthenticated();
      allow create: if isMainAdmin() || isCollegeAdmin();
      allow update, delete: if isMainAdmin() || isCollegeAdmin();
    }

    match /questions/{questionId} {
      allow read: if isAuthenticated();
      allow create: if isMainAdmin() || isCollegeAdmin();
      allow update, delete: if isMainAdmin() || isCollegeAdmin();
    }

    // --- Exams & Results ---
    match /exams/{examId} {
      allow read: if isAuthenticated();
      allow create: if isMainAdmin() || isCollegeAdmin();
      allow update, delete: if isMainAdmin() || isCollegeAdmin();
    }

    match /exam_results/{resultId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isMainAdmin() || isCollegeAdmin();
    }

    // --- Global Settings ---
    match /settings/{document} {
      allow read: if true;
      allow write: if isMainAdmin();
    }

    // Default Fallback Lockdown
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
