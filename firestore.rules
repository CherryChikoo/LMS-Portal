rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Safe Helper Functions ---
    function isAuthenticated() { 
      return request.auth != null; 
    }
    
    function isOwner(userId) { 
      return isAuthenticated() && request.auth.uid == userId; 
    }

    function hasUserDoc() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return hasUserDoc() 
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data 
        : {};
    }

    function getRole() {
      return isAuthenticated() && request.auth.token.keys().hasAll(['role'])
        ? request.auth.token.role
        : getUserData().get('role', 'student');
    }

    function getUserCollege() {
      return isAuthenticated() && request.auth.token.keys().hasAll(['collegeId'])
        ? request.auth.token.collegeId
        : getUserData().get('collegeId', '');
    }

    function isMainAdmin() {
      let role = getRole();
      return role == 'main_admin' || role == 'admin' || role == 'superadmin';
    }

    function isCollegeAdmin() {
      return isMainAdmin() || getRole() == 'college_admin';
    }

    function isStudent() {
      return getRole() == 'student';
    }

    function belongsToSameCollege(collegeId) {
      return isMainAdmin() || (getUserCollege() != '' && getUserCollege() == collegeId);
    }

    // --- Users & Students ---
    match /users/{userId} {
      allow read: if isAuthenticated() && (
        isOwner(userId) || 
        (request.auth.token.email != null && resource.data.email == request.auth.token.email) ||
        isMainAdmin() || 
        (isCollegeAdmin() && resource.data.collegeId == getUserCollege())
      );
      allow create: if isAuthenticated() && (isOwner(userId) || isMainAdmin() || (isCollegeAdmin() && request.resource.data.collegeId == getUserCollege()));
      allow update: if isMainAdmin() || 
                    (isCollegeAdmin() && resource.data.collegeId == getUserCollege() && request.resource.data.collegeId == getUserCollege()) || 
                    (isOwner(userId) && request.resource.data.role == resource.data.role && request.resource.data.collegeId == resource.data.collegeId);
      allow delete: if isMainAdmin() || (isCollegeAdmin() && resource.data.collegeId == getUserCollege());
    }

    match /students/{studentId} {
      allow read: if isAuthenticated() && (
        isOwner(studentId) || 
        (request.auth.token.email != null && resource.data.email == request.auth.token.email) ||
        isMainAdmin() || 
        (isCollegeAdmin() && resource.data.collegeId == getUserCollege())
      );
      allow create: if isAuthenticated() && (isOwner(studentId) || isMainAdmin() || (isCollegeAdmin() && request.resource.data.collegeId == getUserCollege()));
      allow update: if isMainAdmin() || 
                    (isCollegeAdmin() && resource.data.collegeId == getUserCollege() && request.resource.data.collegeId == getUserCollege()) ||
                    (isOwner(studentId) && request.resource.data.collegeId == resource.data.collegeId);
      allow delete: if isMainAdmin() || (isCollegeAdmin() && resource.data.collegeId == getUserCollege());
    }

    // --- Colleges ---
    match /colleges/{collegeId} {
      allow read: if isAuthenticated();
      allow create, delete: if isMainAdmin();
      allow update: if isMainAdmin() || (isCollegeAdmin() && belongsToSameCollege(collegeId));
    }

    // --- Academic Entities ---
    match /courses/{courseId} {
      allow read: if isAuthenticated() && belongsToSameCollege(resource.data.collegeId);
      allow create: if isMainAdmin() || (isCollegeAdmin() && belongsToSameCollege(request.resource.data.collegeId));
      allow update, delete: if isMainAdmin() || (isCollegeAdmin() && belongsToSameCollege(resource.data.collegeId));
    }

    match /resources/{resourceId} {
      allow read: if isAuthenticated() && belongsToSameCollege(resource.data.collegeId);
      allow create: if isMainAdmin() || (isCollegeAdmin() && belongsToSameCollege(request.resource.data.collegeId));
      allow update, delete: if isMainAdmin() || (isCollegeAdmin() && belongsToSameCollege(resource.data.collegeId));
    }

    match /batches/{batchId} {
      allow read: if isAuthenticated() && belongsToSameCollege(resource.data.collegeId);
      allow create: if isMainAdmin() || (isCollegeAdmin() && belongsToSameCollege(request.resource.data.collegeId));
      allow update, delete: if isMainAdmin() || (isCollegeAdmin() && belongsToSameCollege(resource.data.collegeId));
    }

    match /questions/{questionId} {
      allow read: if isAuthenticated() && (belongsToSameCollege(resource.data.collegeId) || isMainAdmin());
      allow create: if isMainAdmin() || (isCollegeAdmin() && belongsToSameCollege(request.resource.data.collegeId));
      allow update, delete: if isMainAdmin() || (isCollegeAdmin() && belongsToSameCollege(resource.data.collegeId));
    }

    // --- Exams & Results ---
    match /exams/{examId} {
      allow read: if isMainAdmin() || 
                     (isCollegeAdmin() && belongsToSameCollege(resource.data.collegeId)) ||
                     (isAuthenticated() && resource.data.status != 'draft' && belongsToSameCollege(resource.data.collegeId));
      allow create: if isMainAdmin() || (isCollegeAdmin() && belongsToSameCollege(request.resource.data.collegeId));
      allow update, delete: if isMainAdmin() || (isCollegeAdmin() && belongsToSameCollege(resource.data.collegeId));
    }

    match /exam_results/{resultId} {
      allow create: if isStudent() && request.resource.data.studentId == request.auth.uid;
      allow read: if isAuthenticated() && (isOwner(resource.data.studentId) || isMainAdmin() || (isCollegeAdmin() && belongsToSameCollege(resource.data.collegeId)));
      allow update, delete: if isMainAdmin() || (isCollegeAdmin() && belongsToSameCollege(resource.data.collegeId));
    }

    // --- Global Settings ---
    match /settings/{document} {
      allow read: if true;
      allow write: if isMainAdmin();
    }

    // Default Fallback Lockdown
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
